# Public app URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://your-public-site.example

# Server-only Supabase admin key; never prefix this with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# PayMongo server-side credentials
PAYMONGO_SECRET_KEY=sk_test_
PAYMONGO_WEBHOOK_SECRET=

# Strong random token used to authorize scheduled cron routes
CRON_SECRET=

# Optional email delivery through Resend
RESEND_API_KEY=
HILIG_EMAIL_FROM=Hilig <bookings@your-verified-domain.example>

# Local development only; simulator refuses to run in production
# HILIG_PAYMENT_MODE=simulation
